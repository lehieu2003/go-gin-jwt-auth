PORT=8080
ENV=development

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_SSLMODE=disable

# JWT Secrets
ACCESS_TOKEN_SECRET=replace-with-a-secure-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-secure-random-refresh-token-secret

# Expiration Durations
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h # 7 days

# Cookie Settings
COOKIE_DOMAIN=
COOKIE_SECURE=false # Set to true in production with HTTPS
COOKIE_SAMESITE=Lax
